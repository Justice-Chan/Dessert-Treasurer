{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dessert Treasurer",
  "version": "0.3.0",
  "identifier": "com.justicechan.dessert-treasurer",
  "build": {
    "beforeDevCommand": "npm run build:web",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "甜點社總務",
        "width": 1380,
        "height": 880,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "backgroundColor": "#fbfaf6",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; connect-src 'self' ipc: http://ipc.localhost https://script.google.com https://script.googleusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
