{
  "name": "dessert-treasurer",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "tauri": "tauri",
    "dev": "npm run tauri dev",
    "build": "npm run tauri build",
    "build:mac": "npm run tauri build -- --bundles app -- --locked",
    "update:mac": "npm run build:mac && node scripts/install-macos.mjs",
    "build:dmg": "npm run tauri build -- --bundles dmg -- --locked",
    "build:windows": "node scripts/build-windows.mjs",
    "test:build": "node --test tests/build.mjs",
    "test:backend": "node --test tests/backend.mjs",
    "check:web": "node scripts/check-syntax.mjs web backend",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tauri-apps/cli": "^2.12.6"
  }
}
